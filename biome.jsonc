// biome-ignore-all format: ~~ Generated by projen. To modify, edit .projenrc.ts and run "yarn projen".
{
  "assist": {
    "actions": {
      "preset": "recommended"
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "build-tools/**",
      ".projenrc.ts",
      "src/**",
      "test/**",
      "!test/negatives",
      "!**/*.d.ts",
      "!**/*.md",
      "projenrc/**",
      "!.backportrc.json",
      "!.gitattributes",
      "!.github/workflows/auto-approve.yml",
      "!.github/workflows/auto-merge.yml",
      "!.github/workflows/auto-tag-dev-v5.9.yml",
      "!.github/workflows/auto-tag-dev-v7.1.yml",
      "!.github/workflows/auto-tag-dev.yml",
      "!.github/workflows/auto-tag-releases-v5.9.yml",
      "!.github/workflows/auto-tag-releases.yml",
      "!.github/workflows/backport.yml",
      "!.github/workflows/build.yml",
      "!.github/workflows/pull-request-lint.yml",
      "!.github/workflows/release.yml",
      "!.github/workflows/upgrade-main.yml",
      "!.github/workflows/upgrade-maintenance-v5.9.yml",
      "!.github/workflows/upgrade-preview-v7.1.yml",
      "!.gitignore",
      "!.npmignore",
      "!.projen/deps.json",
      "!.projen/files.json",
      "!.projen/tasks.json",
      "!.vscode/extensions.json",
      "!.vscode/settings.json",
      "!jest.config.json",
      "!projenrc/tsconfig.json",
      "!releases.json",
      "!test/tsconfig.json",
      "!tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSpacing": true,
      "quoteProperties": "preserve",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "error",
        "useLiteralKeys": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/test/**",
              "**/build-tools/**",
              "**/.projenrc.ts",
              "**/projenrc/**"
            ]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noUselessAwait": "error"
      },
      "style": {
        "noCommonJs": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "off",
        "useArrayLiterals": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "overrides": [
    {
      "includes": [
        "test/**"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    }
  ],
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json"
}
